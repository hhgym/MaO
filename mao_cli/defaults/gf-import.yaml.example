# Wird von mao config init direkt als gf-import.yaml angelegt.
# Alle tatsächlichen Tabellen- und Viewnamen stehen zentral in tables.ini.
# Formular 3 speichert lehrkraft_id; Formular 5 speichert lerngruppe_schuljahr_id.
# MaO_Orga_2.kurs_id bekommt nur in Stufe 11/12 die unveränderte
# orga_lerngruppe_schuljahr.id; in Stufe 5–10 bleibt kurs_id NULL.
form_id: 16
page_size: 200
timeout: 60
fields:
  klasse: "1"
  kurs: "5"
  lehrkraft: "3"
  teilnehmende: "7"
  leermeldung: "10"  # Checkboxwert Leermeldung, falls keine Schueler:innen gemeldet werden
# Alle vorhandenen Schülerinnen und Schüler der folgenden Klassen werden ergänzt.
mandatory_classes: ["5-1", "5-2", "6-1", "6-2", "7-3"]
# 7-4 nur ergänzen, wenn diese Klasse im aktiven Schuljahr existiert.
optional_mandatory_classes: ["7-4"]
queries:
  # Stammdaten des aktiven Schuljahres; Spaltennamen müssen genau passen.
  students: 'SELECT matrikelnummer, vorname, nachname, geschlecht, klasse FROM {{table.students_table}}'
  # Aktuelle Lerngruppen (derzeit alle Mathematik): pro Pflichtklasse genau eine
  # eindeutige Lerngruppe mit Lehrkraft. Später bei weiteren Fächern filtern.
  mandatory: "SELECT klassenname AS klasse, lehrkraft_id, lerngruppe_schuljahr_id FROM {{table.current_groups_view}} WHERE typ = 'klasse' AND klassenname IN ('5-1', '5-2', '6-1', '6-2', '7-3', '7-4') AND lehrkraft_id IS NOT NULL"
  # Feld 3: Lehrkraft-ID bereits numerisch. Nur Existenz anhand id prüfen.
  teachers: 'SELECT id FROM {{table.teachers_table}}'
  # Feld 5 liefert lerngruppe_schuljahr_id, Feld 3 liefert lehrkraft_id.
  # Erforderliche Spalten: lerngruppe_schuljahr_id, lehrkraft_id.
  # Kombinationen aus Lerngruppe und Lehrkraft prüfen; keine Einsatz-ID abbilden.
  courses: 'SELECT lerngruppe_schuljahr_id, lehrkraft_id FROM {{table.current_groups_view}} WHERE lerngruppe_schuljahr_id IS NOT NULL AND lehrkraft_id IS NOT NULL'
