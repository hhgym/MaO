# Wird von mao config init als zentrale Vorlage raumregeln.yaml angelegt (Konfigurationsordner, nicht im Repository).
# Maßgeblich ist die Datei im Jahrgangsordner (Jahrgang/<Nr>_<Schuljahr>/raumregeln.yaml), weil sich die Teilnehmerzahlen
# je Stufe jedes Jahr ändern. Anlegen: mao raumzuteilung --regeln-anlegen; neue Jahrgänge (mao jahrgang new) übernehmen
# die Regeln des letzten Jahrgangs.
# Raumcodes entsprechen der Spalte raumcode der Raumtabelle (tables.ini: rooms_table).
# Befehl: mao raumzuteilung --dry-run --report raum.json   (prüfen)  /  --apply  (schreiben)
rooms:
  # Zielräume je Klassenstufe. Stufen 5 und 6 mit gemeinsamen Räumen werden je Raum 15 + 15 gefüllt.
  grade_rooms:
    "5":  ["R01", "R02", "R03", "R04"]
    "6":  ["R01", "R02", "R03", "R04"]
    "7":  ["R05", "R06", "R07"]
    "8":  ["R08", "R09"]
    "9":  ["R10"]
    "10": ["R11"]
    "11": ["Aula"]
    "12": ["Aula"]
  # Sammelräume (optional): nehmen alle, die nicht in ihre festen Räume (grade_rooms) passen oder keinen haben, mit
  # möglichst wenigen Räumen und möglichst wenig Stufenmischung auf: volle Räume bleiben rein, die Reste teilen sich einen Raum. Dann in grade_rooms nur die wirklich festen Räume eintragen.
  # sammel: ["R20", "R21", "R22"]
  # sammel_max_spanne: 2      # optional: gemischte Räume nur mit Stufen innerhalb dieser Spanne (1 = Nachbarstufen)
  # sammel_stil: rein_zuerst   # volle Räume je Stufe, Reste gemeinsam in einem Sammelraum; alternativ: nachbarn
  # Überlauf (höchstens max_per_room Plätze)
  reserve: "R12"
  # Die besten Teilnehmenden unter den aktuell Gemeldeten (Vorjahrespunkte laut points_last_year_view) sitzen gemeinsam.
  top15:
    by_grade:        # Stufe 7–10: eigener Raum je Stufe
      "7": "R13"
      "8": "R14"
      "9": "R15"
      "10": "R16"
    oberstufe: "R17" # Stufe 11 und 12 zusammen
# fill: full = Raum für Raum auffüllen (wenige Aufsichten), even = gleichmäßig auf die Zielräume verteilen
fill: full
top_count: 15        # Anzahl je Top-Gruppe
max_per_room: 15     # Obergrenze je Raum (zusätzlich gilt die Datenbankkapazität)
paired_capacity: 30  # Räume, die Stufe 5 und 6 gemeinsam nutzen
db_capacity_rooms: ["Aula"]  # Räume, für die nur die Datenbankkapazität gilt
# Externe Teilnehmende (Grundschulen): eigene Räume, nie dieselben wie im Hauptwettbewerb.
# Zuteilung mit: mao raumzuteilung --extern --dry-run   /   --apply. Weiterer Raum = weiterer Eintrag (je max_per_room Plätze).
extern:
  rooms: ["R18"]

# Aufsichten (mao aufsichten prüft nach der Raumzuteilung): Lehrkräfte je belegtem Raum.
# Zählende Rollen aus der Aufsichtentabelle: Aufsicht, Reserve, Fachaufsicht.
aufsichten:
  lehrkraefte_pro_raum: 1
  zaehlende_rollen: ["Aufsicht"]

# Einsatz der Oberstufe (mao einsatz): Voreinstellungen; Schalter auf der Kommandozeile haben Vorrang.
# Alle Schlüssel sind optional (Standard in Klammern).
einsatz:
  aufsichten_pro_raum: 1   # Schüler-Aufsichten je Raum mit Teilnehmenden (1)
  reserve: 3               # Reserve ohne Raum (3)
  hof_gruppen: 2           # Hofgruppen/Schichten (2)
  # hof_pro_gruppe: 10     # höchstens so viele je Hofgruppe (unbegrenzt)
  # ohne_raum: ["Aula"]    # Räume ohne Schüler-Aufsicht ([])
  # formular: 59           # Gravity-Forms-Formular mit den Einsatzwünschen (59)
